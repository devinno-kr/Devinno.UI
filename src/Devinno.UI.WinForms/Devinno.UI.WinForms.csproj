<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms 어댑터: 캔버스(SKControl) 하나 + 숨긴 TextBox 하나. 패키지가 windows10.0.19041 TFM 만 제공 -->
  <PropertyGroup>
    <!-- 패키지 공통 설정은 ../Directory.Build.props -->
    <PackageId>Devinno.UI.WinForms</PackageId>
    <Description>WinForms adapter for Devinno.UI: ViewControl puts a DvApp on a form (IME text input including Korean, optional touch mode). The app must target net9.0-windows10.0.19041.0 or later.</Description>
    <PackageTags>ui;hmi;skiasharp;winforms;touch;industrial;dvml;llm;ai</PackageTags>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devinno.UI\Devinno.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="3.119.4" />
  </ItemGroup>

</Project>

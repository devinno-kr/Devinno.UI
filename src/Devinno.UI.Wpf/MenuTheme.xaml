<!-- ViewControl.ThemeWindow 이 앱 리소스에 넣는 메뉴 스타일. 색은 Dv.Menu.* 브러시(WindowTheme 가 테마 토큰으로 채움)를 DynamicResource 로 읽는다 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Dv.Menu.Bar}" />
        <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Text}" />
    </Style>

    <Style TargetType="ToolBarTray">
        <Setter Property="Background" Value="{DynamicResource Dv.Menu.Bar}" />
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource Dv.Menu.Bar}" />
        <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Text}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Dv.Menu.Status}" />
        <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Text}" />
    </Style>

    <!-- 펼친 메뉴 판 — 맨 위 메뉴·하위 메뉴·오른쪽 클릭 메뉴가 같은 모양 -->
    <ControlTemplate x:Key="Dv.Menu.PanelTemplate" TargetType="ContextMenu">
        <Border Background="{DynamicResource Dv.Menu.Panel}" BorderBrush="{DynamicResource Dv.Menu.Border}" BorderThickness="1" Padding="0,3">
            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
        </Border>
    </ControlTemplate>

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Text}" />
        <Setter Property="Template" Value="{StaticResource Dv.Menu.PanelTemplate}" />
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,3" Background="{DynamicResource Dv.Menu.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴 막대의 항목 -->
    <ControlTemplate x:Key="Dv.Menu.TopLevel" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="8,3" SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{DynamicResource Dv.Menu.Panel}" BorderBrush="{DynamicResource Dv.Menu.Border}" BorderThickness="1" Padding="0,3">
                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dv.Menu.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dv.Menu.Panel}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 펼친 메뉴 안의 항목(하위 메뉴가 있으면 화살표) -->
    <ControlTemplate x:Key="Dv.Menu.Submenu" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Margin="3,0" Padding="0,4" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" SharedSizeGroup="Dv.Menu.Header" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Dv.Menu.Gesture" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="Check" Visibility="Collapsed" Data="M 1,6 L 5,10 L 12,2" Stroke="{DynamicResource Dv.Menu.Check}" StrokeThickness="1.8"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,16,0" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" />
                <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed" Data="M 0,0 L 4,4 L 0,8 Z" Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-4" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{DynamicResource Dv.Menu.Panel}" BorderBrush="{DynamicResource Dv.Menu.Border}" BorderThickness="1" Padding="0,3">
                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dv.Menu.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Disabled}" />
                <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource Dv.Menu.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Dv.Menu.Text}" />
        <Setter Property="Template" Value="{StaticResource Dv.Menu.Submenu}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Dv.Menu.TopLevel}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Dv.Menu.TopLevel}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

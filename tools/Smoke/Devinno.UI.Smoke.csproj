<Project Sdk="Microsoft.NET.Sdk">
  <!-- P7-7 장시간 스모크 — 데모 페이지를 실제 OpenTK 창에 띄우고 조작을 계속하며 1분마다 지표, 1시간마다 요약을 남긴다. 솔루션 비포함. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Devinno.UI.Smoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\samples\Devinno.UI.Demo\Devinno.UI.Demo.csproj" />
    <ProjectReference Include="..\..\src\Devinno.UI.OpenTK\Devinno.UI.OpenTK.csproj" />
  </ItemGroup>
</Project>

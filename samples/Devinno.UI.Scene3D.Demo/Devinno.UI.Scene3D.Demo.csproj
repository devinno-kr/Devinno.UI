<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Devinno.UI.OpenTK\Devinno.UI.OpenTK.csproj" />
    <ProjectReference Include="..\..\src\Devinno.UI.Scene3D\Devinno.UI.Scene3D.csproj" />
  </ItemGroup>

  <!-- dvml 소스 생성기(저장소 안에서는 패키지 props 가 안 걸리므로 직접 분석기로 연결하고 dvml 을 넘긴다) -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Devinno.UI.Generators\Devinno.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Pages/*.dvml" />
  </ItemGroup>

  <!-- 시험 모델: Blender 에서 내보낸 glTF(로봇 팔, 리프트, 기어, 팬, 펌프, 문, 크랭크, 텍스처 명판, 카메라 3대, 크랭크 클립) -->
  <ItemGroup>
    <None Include="Assets\scene3d_test.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- Bench: GLFW 창 포인터 -->
  </PropertyGroup>

</Project>

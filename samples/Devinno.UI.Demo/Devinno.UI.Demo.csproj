<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Devinno.UI.OpenTK\Devinno.UI.OpenTK.csproj" />
  </ItemGroup>

  <!-- dvml 소스 생성기(저장소 안에서는 패키지 props 가 안 걸리므로 직접 분석기로 연결하고 dvml 을 넘긴다) -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Devinno.UI.Generators\Devinno.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Pages/*.dvml" />
    <AdditionalFiles Include="Bars/*.dvml" />
    <AdditionalFiles Include="Dialogs/*.dvml" />
    <AdditionalFiles Include="Showcase/*.dvml" />
  </ItemGroup>

  <!-- 동영상 페이지의 클립(testsrc2 8초, 640×360 H.264) -->
  <ItemGroup>
    <None Include="Assets\demo-clip.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

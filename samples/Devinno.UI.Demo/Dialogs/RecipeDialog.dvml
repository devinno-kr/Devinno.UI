<DvDialogFrame vm="RecipeDialog" title="Edit recipe" subtitle="Save asks you to confirm once more" style="width:420">
  <DvInput value="{Bind Name}" placeholder="Name"/>
  <DvInput value="{Bind Temp}" keyboard-type="numeric" min="0" max="120" format="0.0" unit="℃"/>
  <DvInput value="{Bind Minutes}" keyboard-type="numeric" min="1" max="240" unit="min"/>
  <DvRow gap="sm">
    <DvSpacer/>
    <DvButton variant="secondary" text="Cancel" onclick="Cancel"/>
    <DvButton variant="primary" text="Save" onclick="Save"/>
  </DvRow>
</DvDialogFrame>

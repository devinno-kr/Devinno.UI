<DvPageFrame vm="InputPage" title="레시피 편집" subtitle="입력을 누르면 편집 — 값은 완료(Enter) 때 한 번만 반영됩니다">
  <DvGrid columns="2">
    <DvCard title="레시피" badge="text">
      <DvStack gap="sm">
        <DvLabel class="label" text="이름"/>
        <DvInput value="{Bind Data.Name}" placeholder="레시피 이름"/>
        <DvLabel class="label" text="기반 레시피 (items)"/>
        <DvSelect value="{Bind Data.BaseRecipe}" items="{Data.Recipes}" item-value="Id" item-text="Name"
                  placeholder="기반 없음"/>
        <DvLabel class="label" text="비밀번호"/>
        <DvInput value="{Bind Data.Password}" keyboard-type="password" placeholder="변경하려면 입력"/>
        <DvLabel class="label" text="메모 (여러 줄 — 네이티브 편집기만)"/>
        <DvInput value="{Bind Data.Memo}" multiline="true"/>
      </DvStack>
    </DvCard>
    <DvCard title="설정값" badge="numeric">
      <DvStack gap="sm">
        <DvLabel class="label" text="온도 (0 ~ 120 ℃, 실수 · ± 0.5)"/>
        <DvInput value="{Bind Data.Temp}" keyboard-type="numeric" min="0" max="120" step="0.5" format="0.0" unit="℃" show-stepper="true"/>
        <DvLabel class="label" text="반복 횟수 (1 ~ 99, 정수 · ± 1)"/>
        <DvInput value="{Bind Data.Repeat}" keyboard-type="numeric" min="1" max="99" unit="회" show-stepper="true"/>
        <DvLabel class="label" text="오프셋 (부호 있는 정수)"/>
        <DvInput value="{Bind Data.Offset}" keyboard-type="numeric"/>
        <DvLabel class="label" text="운전 모드 (DvOption)"/>
        <DvSelect value="{Bind Data.Mode}">
          <DvOption value="auto" text="자동" icon="fa-robot"/>
          <DvOption value="manual" text="수동" icon="fa-hand"/>
          <DvOption value="stop" text="정지" icon="fa-stop"/>
        </DvSelect>
        <DvLabel class="label" text="회전 방향 (enum)"/>
        <DvSelect value="{Bind Data.Direction}"/>
        <DvLabel class="label" text="설비 번호 (읽기 전용)"/>
        <DvInput value="{Data.Machine}"/>
        <DvLabel class="label" text="예약 시각 (datetime)"/>
        <DvDateTimeInput value="{Bind Data.ReserveAt}"/>
        <DvLabel class="label" text="조회일 (date)"/>
        <DvDateTimeInput value="{Bind Data.Day}"/>
        <DvLabel class="label" text="시작 시각 (time, 초)"/>
        <DvDateTimeInput value="{Bind Data.Start}" show-seconds="true"/>
        <DvLabel class="label" text="펜 색"/>
        <DvColorInput value="{Bind Data.Pen}"/>
      </DvStack>
    </DvCard>
  </DvGrid>
  <DvRow>
    <DvButton text="저장" icon="fa-floppy-disk" variant="primary" onclick="Save"/>
    <DvLabel class="caption muted" text="{Saved}"/>
  </DvRow>
</DvPageFrame>

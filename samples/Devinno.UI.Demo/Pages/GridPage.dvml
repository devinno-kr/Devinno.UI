<DvPageFrame vm="GridPage">
  <DvRow align="start">
    <DvStack gap="none" grow="1" style="width:0">
      <DvLabel class="heading" text="Data Grid"/>
      <DvLabel class="label muted" text="300k rows · frozen columns · multi-select (row-key) · tap-header sort (stacked) · group headers · summary — values refresh every 0.5 s (Repaint) · edit cells"/>
    </DvStack>
    <DvButton variant="secondary" icon="fa-arrow-left" text="Back" onclick="Back" visible="{ShowBack}"/>
  </DvRow>
  <DvRow>
    <DvLabel class="body" text="{SelectionText}"/>
    <DvSpacer/>
    <DvButton variant="secondary" text="Clear selection" icon="fa-xmark" onclick="ClearSelection"/>
  </DvRow>
  <DvCard title="Equipment Tags" badge="{CountText}" grow="1">
    <DvStyle>
      .alarm-row { background: token(tone-danger-soft) }
      .over      { background: token(tone-danger); color: #ffffff; font-weight: bold }
      .under     { color: token(tone-info-fg); font-weight: bold }
    </DvStyle>
    <DvDataGrid items="{Rows}" grow="1" selection-mode="multi" selection="{Bind Picked}" row-key="Id"
                onrowclick="Inspect" row-class="RowClass"
                style="border-radius:token(radius.md); border:1 solid token(border)">
      <DvColumn header="No" field="Id" width="90" frozen="true" sortable="true"/>
      <DvColumn header="Tag" field="Tag" width="150" frozen="true" sortable="true" filter="text"/>
      <DvColumn header="Use" field="Use" width="64" cell-type="check"/>
      <DvColumn header="Alarm" field="AlarmLamp" width="64" cell-type="lamp" blink="true"/>
      <DvColumn header="Ack" width="96" cell-type="button" text="Ack" icon="fa-check" onclick="Ack" enabled="CanAck"/>
      <DvColumn header="Name" field="Name" width="140" cell-type="input"/>
      <DvColumn header="Setpoint" field="SetPoint" width="110" cell-type="input" min="0" max="120" unit="℃" format="0.0" onbeforecommit="CheckSetPoint" filter="range"/>
      <DvColumn header="Mode" field="Mode" width="110" cell-type="select" filter="auto">
        <DvOption value="auto" text="Auto" icon="fa-robot"/>
        <DvOption value="manual" text="Manual" icon="fa-hand"/>
      </DvColumn>
      <DvColumn header="Schedule" field="ReserveAt" width="140" cell-type="datetime" format="MM-dd HH:mm" filter="date"/>
      <DvColumn header="Color" field="Pen" width="130" cell-type="color"/>
      <DvColumn header="Description" field="Desc" width="280"/>
      <DvColumnGroup header="Process value">
        <DvColumn header="Value" field="Value" width="120" format="0.00" sortable="true" cell-class="ValueClass"/>
        <DvColumn header="Unit" field="Unit" width="80" align="center"/>
        <DvColumn header="State" field="State" width="100" align="center" sortable="true" filter="values"/>
      </DvColumnGroup>
      <DvColumn header="Updated" field="Time" width="140" format="HH:mm:ss.fff" sortable="true"/>
      <DvColumn header="Equipment" field="Equip.Name" width="160" sortable="true"/>
      <DvSummaryRow title="Avg" fn="avg"/>
      <DvSummaryRow title="Max">
        <DvSummary field="Tag" fn="count" format="#,0"/>
        <DvSummary field="Value" fn="max" format="0.00"/>
      </DvSummaryRow>
    </DvDataGrid>
  </DvCard>
</DvPageFrame>

<DvPageFrame vm="ComponentDashboardPage">
  <DvRow align="start">
    <DvStack gap="none" grow="1" style="width:0">
      <DvLabel class="heading" text="Han River WTP Line 2"/>
      <DvLabel class="label muted" text="Live operations dashboard"/>
    </DvStack>
    <DvButton variant="secondary" icon="fa-arrow-left" text="Back" onclick="Back" visible="{ShowBack}"/>
  </DvRow>
  <DvStyle>
    .dial { aspect-ratio:1; border-radius:999; border:4 token(border-strong); padding:6;
            display:flex; flex-direction:column; align-items:stretch;
            background:linear-gradient(180deg, token(surface-raised), token(surface)); box-shadow: token(shadow.lg) }
  </DvStyle>

  <DvRow>
    <DvBadge tone="{StatusTone}" text="{StatusText}"/>
    <DvLabel class="label subtle" text="2026.10.12  14:32"/>
    <DvSpacer/>
    <DvButton variant="primary" text="Start (hold 1.5 s)" onclick="Start" hold="1500"/>
    <DvButton variant="danger" text="E-Stop" onclick="Stop"/>
  </DvRow>

  <DvGrid columns="4">
    <DvStat label="Treated flow" value="1,284" unit="m3/h" delta="+3.2%" tone="success"/>
    <DvStat label="Outlet turbidity" value="0.18" unit="NTU" delta="-0.04" tone="success"/>
    <DvStat label="Power use" value="412" unit="kW" delta="+8.1%" tone="warning"/>
    <DvStat label="Equipment uptime" value="98.6" unit="%" delta="On target" tone="info"/>
  </DvGrid>

  <DvRow align="stretch" grow="1" gap="lg">
    <DvStack grow="1" gap="lg">
      <DvRow align="stretch" grow="1" gap="lg">
        <DvCard title="Tank levels" badge="3 units" grow="1">
          <DvRow align="stretch" grow="1" gap="lg" padding="none sm">
            <DvStack align="stretch" gap="sm" grow="1">
              <DvTank value="64" unit="%" alarm-zones="0:70:#3b82f6 70:88:#f59e0b 88:100:#ef4444" grow="1"/>
              <DvLabel class="label muted" style="text-align:center" text="Raw water"/>
            </DvStack>
            <DvStack align="stretch" gap="sm" grow="1">
              <DvTank value="81" unit="%" alarm-zones="0:70:#3b82f6 70:88:#f59e0b 88:100:#ef4444" grow="1"/>
              <DvLabel class="label muted" style="text-align:center" text="Flocculation"/>
            </DvStack>
            <DvStack align="stretch" gap="sm" grow="1">
              <DvTank value="93" unit="%" alarm-zones="0:70:#3b82f6 70:88:#f59e0b 88:100:#ef4444" grow="1"/>
              <DvLabel class="label muted" style="text-align:center" text="Clear well"/>
            </DvStack>
          </DvRow>
        </DvCard>
        <DvCard title="Transfer pressure" badge="bar x10" grow="1">
          <DvRow align="stretch" grow="1" gap="lg" padding="none xs">
            <DvStack align="stretch" gap="sm" grow="1">
              <DvBox class="dial" grow="1"><DvGauge value="58" alarm-zones="0:65:#10b981 65:85:#f59e0b 85:100:#ef4444" ticks="20" minor-ticks="5" grow="1"/></DvBox>
              <DvLabel class="label muted" style="text-align:center" text="Main line"/>
            </DvStack>
            <DvStack align="stretch" gap="sm" grow="1">
              <DvBox class="dial" grow="1"><DvGauge value="79" alarm-zones="0:65:#10b981 65:85:#f59e0b 85:100:#ef4444" ticks="20" minor-ticks="5" grow="1"/></DvBox>
              <DvLabel class="label muted" style="text-align:center" text="Backwash line"/>
            </DvStack>
          </DvRow>
        </DvCard>
      </DvRow>
      <DvCard title="Recent log" badge="Today">
        <DvTabs>
          <DvTab text="Alarms">
            <DvStatusItem label="Filter B diff. pressure over limit" state="fault" status="14:28"/>
            <DvStatusItem label="Flocculation level in caution zone" state="warn" status="13:52"/>
          </DvTab>
          <DvTab text="Run log">
            <DvStatusItem label="Pump 2 started" state="run" status="12:10"/>
            <DvStatusItem label="Switched to auto mode" state="off" status="09:00"/>
          </DvTab>
          <DvTab text="Run settings">
            <DvRow gap="md">
              <DvSegment value="{Bind Data.PumpSpeed}">
                <DvOption value="1" text="Low"/>
                <DvOption value="2" text="Mid"/>
                <DvOption value="3" text="High"/>
              </DvSegment>
              <DvButton text="Light" value="{Bind Data.Light}"/>
              <DvButton text="Fan" value="{Bind Data.Fan}"/>
            </DvRow>
          </DvTab>
        </DvTabs>
      </DvCard>
    </DvStack>

    <DvCard title="Equipment status" badge="6 units" width="310">
      <DvStatusItem label="Intake pump #1" state="{PumpState}" status="{PumpText}"/>
      <DvStatusItem label="Intake pump #2" state="{PumpState}" status="{PumpText}"/>
      <DvStatusItem label="Transfer pump #1" state="run" status="Running"/>
      <DvStatusItem label="Chemical feeder" state="off" status="Standby"/>
      <DvStatusItem label="Filter A" state="run" status="Running"/>
      <DvStatusItem label="Filter B" state="fault" status="Alarm" blink="true"/>
      <DvSpacer/>
      <DvBox style="height:1; background:token(border)"/>
      <DvSwitch label="Auto mode" value="{Bind Data.AutoMode}"/>
      <DvSwitch label="Mute alarm" value="{Bind Data.Mute}"/>
    </DvCard>
  </DvRow>
</DvPageFrame>

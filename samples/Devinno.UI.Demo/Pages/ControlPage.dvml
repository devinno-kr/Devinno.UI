<DvStack vm="ControlPage" style="background: token(background)">
  <DvStack style="padding:24; gap:16">
    <DvLabel class="title" text="Control handle demo"/>
    <DvLabel id="lblState" class="body" text="Standby"/>
    <DvLabel id="lblClick" class="caption" text=" "/>
    <DvRow>
      <DvButton id="btnStart" text="Start" variant="primary" icon="fa-play" onclick="Start"/>
      <DvButton id="btnStop" text="Stop" variant="danger" icon="fa-stop" onclick="Stop"/>
      <DvSwitch label="Lock" value="{Bind Locked}"/>
    </DvRow>
  </DvStack>
  <!-- 버튼 Bounds(창 좌표) 바로 아래. 루트가 창 원점이라 그대로 left/top 에 쓸 수 있다. -->
  <DvBox visible="{ShowHint}" style="position:absolute; left:{PopX}; top:{PopY}; padding:10; background: token(surface-raised); border:1 solid token(border-strong); border-radius:8">
    <DvLabel class="caption" text="Hint box shown right below the Start button (uses Bounds)"/>
  </DvBox>
</DvStack>

<DvPageFrame vm="DialogPage" title="Dialogs" subtitle="Recipe editor · message box · built-in input/number/select boxes · comm alarms (every 4 s, one per ID)">
  <DvRow gap="lg" align="stretch">
    <DvCard title="Current recipe" grow="1">
      <DvLabel class="title" text="{Recipe.Name}"/>
      <DvLabel class="body muted" text="Temperature {Recipe.Temp} ℃ · Time {Recipe.Minutes} min"/>
      <DvRow gap="sm">
        <DvButton variant="primary" text="Edit recipe" onclick="EditRecipe"/>
        <DvButton variant="secondary" text="Reset" onclick="AskReset"/>
      </DvRow>
    </DvCard>
    <DvCard title="Last event" grow="1">
      <DvLabel class="body" text="{LastEvent}"/>
      <DvRow>
        <DvButton variant="ghost" text="Close all dialogs" onclick="CloseAll"/>
        <DvButton variant="secondary" text="Lock (auto after 30 s idle)" onclick="Lock"/>
      </DvRow>
    </DvCard>
  </DvRow>
  <DvCard title="Built-in boxes (App.InputBox · InputNumber · SelectBox)">
    <DvLabel class="body muted" text="Operator {Operator} · Setpoint {Setpoint} ℃ · Run mode {ModeText}"/>
    <DvRow gap="sm">
      <DvButton variant="secondary" text="Input box" onclick="AskOperator"/>
      <DvButton variant="secondary" text="Number box (0~100)" onclick="AskSetpoint"/>
      <DvButton variant="secondary" text="Select box" onclick="AskMode"/>
    </DvRow>
  </DvCard>
</DvPageFrame>

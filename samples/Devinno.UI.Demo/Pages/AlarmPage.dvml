<DvPageFrame vm="AlarmPage">
  <DvRow align="start">
    <DvStack gap="none" grow="1" style="width:0">
      <DvLabel class="heading" text="Alarms"/>
      <DvLabel class="label muted" text="ISA-18.2 MVP · tap the banner = ack the top-priority alarm, ACK in the list = ack that alarm"/>
    </DvStack>
    <DvButton variant="secondary" icon="fa-arrow-left" text="Back" onclick="Back" visible="{ShowBack}"/>
  </DvRow>
  <DvAlarmBanner items="{Alarms}" comm-alarm="{CommText}" onack="Ack" style="border-radius:12"/>
  <DvRow>
    <DvButton variant="danger" text="Raise Critical" onclick="RaiseCritical"/>
    <DvButton variant="secondary" text="Raise Major" onclick="RaiseMajor"/>
    <DvButton variant="secondary" text="Raise Minor" onclick="RaiseMinor"/>
    <DvButton variant="ghost" text="Toggle comm fault" onclick="ToggleComm"/>
    <DvSpacer/>
    <DvBadge tone="warning" text="{UnAckedText}"/>
    <DvButton variant="primary" text="Ack all" onclick="AckAll"/>
  </DvRow>
  <DvCard title="Alarm list" badge="{CountText}" grow="1">
    <DvAlarmList items="{Alarms}" onack="Ack" grow="1"/>
  </DvCard>
</DvPageFrame>

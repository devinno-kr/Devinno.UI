<DvPageFrame vm="MotionNextPage" title="Next page" subtitle="Page transition motion — going back works the same way">
  <DvCard title="Transitioned page">
    <DvStack gap="md">
      <DvLabel class="body" text="Arrived via DvApp.Show(page, DvPageTransition.Slide)."/>
      <DvRow>
        <DvButton text="Back with Slide" icon="fa-left-long" variant="primary" onclick="BackSlide"/>
        <DvButton text="Back with Fade" icon="fa-rotate-left" variant="secondary" onclick="BackFade"/>
      </DvRow>
    </DvStack>
  </DvCard>
</DvPageFrame>

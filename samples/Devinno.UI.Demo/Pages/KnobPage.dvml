<DvPageFrame vm="KnobPage" title="Setpoint adjust" subtitle="Grab and turn a knob to change the value; it commits on release">
  <DvRow visible="{ShowBack}">
    <DvButton variant="ghost" text="← Back" onclick="Back"/>
  </DvRow>
  <DvGrid columns="3">
    <DvCard title="Valve opening" badge="%">
      <DvStack align="center" gap="sm">
        <DvKnob value="{Bind Data.Valve}" unit="%" style="width:150; height:150"/>
        <DvLabel class="caption" text="0 ~ 100"/>
      </DvStack>
    </DvCard>
    <DvCard title="Pump speed" badge="rpm">
      <DvStack align="center" gap="sm">
        <DvKnob value="{Bind Data.Speed}" min="0" max="3600" step="10" input-mode="both" style="width:150; height:150"/>
        <DvLabel class="caption" text="0 ~ 3600, step 10 · drag + tap keypad"/>
      </DvStack>
    </DvCard>
    <DvCard title="Temperature SP" badge="C">
      <DvStack align="center" gap="sm">
        <DvKnob value="{Bind Data.Temp}" min="0" max="80" step="0.5" input-mode="tap" style="width:150; height:150"/>
        <DvLabel class="caption" text="0 ~ 80, step 0.5 · tap keypad"/>
      </DvStack>
    </DvCard>
  </DvGrid>
</DvPageFrame>

<DvPageFrame vm="EquipmentPage">
  <DvRow align="start">
    <DvStack gap="none" grow="1" style="width:0">
      <DvLabel class="heading" text="Equipment list"/>
      <DvLabel class="label muted" text="DvRepeat + overflow:scroll — wheel · drag and release (inertia) · right thumb. Dragging to scroll does not press buttons"/>
    </DvStack>
    <DvButton variant="secondary" icon="fa-arrow-left" text="Back" onclick="Back" visible="{ShowBack}"/>
  </DvRow>
  <DvRow>
    <DvBadge tone="info" text="{SelectedText}"/>
    <DvBadge tone="neutral" text="{AutoText}"/>
  </DvRow>
  <DvCard title="Pumps · Valves" badge="{CountText}" grow="1">
    <DvRepeat items="{Items}" gap="xs" grow="1" style="overflow:scroll">
      <DvRow style="padding:4 8">
        <DvLabel class="caption muted" text="{Index}" style="width:28"/>
        <DvStatusItem grow="1" label="{Item.Name}" state="{Item.State}" status="{Item.StatusText}"/>
        <DvLabel class="caption muted" text="Auto"/>
        <DvToggle value="{Bind Item.Auto}"/>
        <DvButton variant="secondary" size="sm" text="OK" onclick="Inspect"/>
      </DvRow>
    </DvRepeat>
  </DvCard>
  <DvCard title="Pressure gauges" badge="Horizontal scroll">
    <DvRepeat items="{Pressures}" style="display:flex; flex-direction:row; gap:16; overflow:scroll; height:164">
      <DvGauge value="{Item}" alarm-zones="0:65:#10b981 65:85:#f59e0b 85:100:#ef4444" style="width:140; height:140"/>
    </DvRepeat>
  </DvCard>
</DvPageFrame>

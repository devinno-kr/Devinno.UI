<DvPageFrame vm="BasicPage" title="Basic Controls" subtitle="Value handles — read and write from code without binding (give an id and the handle owns the value)">
  <DvRow gap="lg" align="stretch" grow="1">
    <DvTabs grow="1">
      <DvTab value="handle" text="Value handles">
        <DvGrid columns="2">
        <DvCard title="No binding (handle owns it)" badge="id">
          <DvStack gap="sm">
            <DvRow>
              <DvLabel class="label" text="Pump run"/>
              <DvSpacer/>
              <DvToggle id="tgPump" style="width:46; height:26"/>
            </DvRow>
            <DvSwitch id="swHeater" label="Heater (DvSwitch)"/>
            <DvLabel class="label" text="Speed"/>
            <DvRow>
              <DvKnob id="knSpeed" min="0" max="100" step="5" unit="%" style="width:110; height:110"/>
              <DvStack gap="sm" grow="1">
                <DvLabel class="label" text="Run mode"/>
                <DvSegment id="segMode">
                  <DvOption value="auto" text="Auto"/>
                  <DvOption value="manual" text="Manual"/>
                  <DvOption value="stop" text="Stop"/>
                </DvSegment>
                <DvLabel class="label" text="Recipe"/>
                <DvSelect id="selRecipe" placeholder="Select">
                  <DvOption value="A" text="Wash A"/>
                  <DvOption value="B" text="Wash B"/>
                  <DvOption value="C" text="Wash C"/>
                </DvSelect>
              </DvStack>
            </DvRow>
            <DvLabel class="label" text="Operator"/>
            <DvInput id="inOperator" placeholder="Name"/>
            <DvLabel class="label" text="Target temp (℃)"/>
            <DvInput id="inTemp" keyboard-type="numeric" min="0" max="120" unit="℃" show-stepper="true"/>
          </DvStack>
        </DvCard>
        </DvGrid>
      </DvTab>
      <DvTab value="choice" text="Check · Radio · Slider">
        <DvGrid columns="2">
          <DvCard title="Checkbox · Radio" badge="new">
            <DvStack gap="xs">
              <DvCheckBox text="Alarm sound (binding)" value="{Bind AlarmSound}"/>
              <DvCheckBox id="chkLog" text="Keep log (handle)"/>
              <DvCheckBox text="Locked item (disabled)" value="true" disabled="true"/>
              <DvLabel class="label" text="Run mode (enum binding)"/>
              <DvRadio text="Auto" value="{Bind Run}" option="Auto"/>
              <DvRadio text="Manual" value="{Bind Run}" option="Manual"/>
              <DvRadio id="rdStop" text="Stop" value="{Bind Run}" option="Stop"/>
              <DvLabel class="label" text="Speed (group — no binding)"/>
              <DvRow gap="lg">
                <DvRadio text="Low" group="speed" option="low"/>
                <DvRadio text="Mid" group="speed" option="mid"/>
                <DvRadio text="High" group="speed" option="high"/>
              </DvRow>
              <DvLabel class="caption muted" text="VM alarm sound = {AlarmSound} · run = {Run}"/>
            </DvStack>
          </DvCard>
          <DvCard title="Slider" badge="new">
            <DvRow gap="lg">
              <DvStack gap="sm" grow="1">
                <DvLabel class="label" text="Valve opening (binding, step 5)"/>
                <DvSlider value="{Bind Valve}" step="5" unit="%" show-value="true"/>
                <DvLabel class="label" text="Light (handle, 0 ~ 1, step 0.1)"/>
                <DvSlider id="slLight" max="1" step="0.1" show-value="true"/>
                <DvLabel class="label" text="Reversed (direction=left) · disabled"/>
                <DvSlider value="{Bind Valve}" step="5" direction="left"/>
                <DvSlider value="{Bind Valve}" disabled="true"/>
                <DvLabel class="caption muted" text="VM valve = {Valve}% · level = {Level} m"/>
              </DvStack>
              <DvSlider value="{Bind Level}" direction="up" max="10" step="0.5" unit="m" show-value="true" style="height:260"/>
            </DvRow>
          </DvCard>
        </DvGrid>
      </DvTab>
      <DvTab value="list" text="List">
        <DvGrid columns="3">
          <DvCard title="Pick one" badge="value">
            <DvStack gap="sm">
              <DvLabel class="label" text="Recipe (items · binding)"/>
              <DvListBox value="{Bind RecipeId}" items="{Recipes}" item-value="Id" item-text="Name"/>
              <DvLabel class="caption muted" text="VM recipe no. = {RecipeId}"/>
            </DvStack>
          </DvCard>
          <DvCard title="Pick many" badge="multi">
            <DvStack gap="sm">
              <DvLabel class="label" text="Alarm zones (selected-items)"/>
              <DvListBox selection-mode="multi" selected-items="{Bind Zones}">
                <DvOption value="A" text="Zone A — Raw material" icon="fa-boxes-stacked"/>
                <DvOption value="B" text="Zone B — Mixing" icon="fa-blender"/>
                <DvOption value="C" text="Zone C — Filling" icon="fa-fill-drip"/>
                <DvOption value="D" text="Zone D — Packing" icon="fa-box"/>
              </DvListBox>
              <DvLabel class="caption muted" text="VM zones = {ZonesText}"/>
            </DvStack>
          </DvCard>
          <DvCard title="Handle (no binding)" badge="id">
            <DvStack gap="sm">
              <DvLabel class="label" text="Work shift"/>
              <DvListBox id="lstShift">
                <DvOption value="day" text="Day"/>
                <DvOption value="swing" text="Swing"/>
                <DvOption value="night" text="Night"/>
              </DvListBox>
              <DvLabel class="label" text="Disabled"/>
              <DvListBox value="{Bind RecipeId}" items="{Recipes}" item-value="Id" item-text="Name" disabled="true" style="height:96"/>
            </DvStack>
          </DvCard>
        </DvGrid>
      </DvTab>
      <DvTab value="tree" text="Tree">
        <DvGrid columns="2">
          <DvCard title="Equipment tree (binding)" badge="new">
            <DvStack gap="sm">
              <DvLabel class="caption muted" text="Tap ▶/▼ to expand or collapse, tap a name to pick it"/>
              <DvTreeView items="{Plant}" item-children="Kids" item-text="Name" value="{Bind PickedEquip}" style="height:360"/>
              <DvLabel class="caption muted" text="VM picked equipment = {PickedEquipText}"/>
            </DvStack>
          </DvCard>
          <DvCard title="Handle (item-value)" badge="id">
            <DvStack gap="sm">
              <DvButton text="Pick Pump 2 (code)" icon="fa-crosshairs" variant="secondary" onclick="PickPump2"/>
              <DvTreeView id="tvPlant" items="{Plant}" item-children="Kids" item-text="Name" item-value="Tag" style="height:300"/>
            </DvStack>
          </DvCard>
        </DvGrid>
      </DvTab>
      <DvTab value="expander" text="Expanders">
        <DvGrid columns="2">
          <DvStack gap="sm">
            <DvLabel class="label" text="Independent (binding · handle · screen remembers)"/>
            <DvExpander header="Run conditions (expanded binding)" expanded="{Bind ShowRun}">
              <DvRow><DvLabel class="body" text="Target temp"/><DvSpacer/><DvLabel class="body" text="65 ℃"/></DvRow>
              <DvRow><DvLabel class="body" text="Wash time"/><DvSpacer/><DvLabel class="body" text="12 min"/></DvRow>
            </DvExpander>
            <DvExpander id="expMore" header="Advanced settings (handle)">
              <DvCheckBox text="Auto restart" value="{Bind AlarmSound}"/>
              <DvSlider value="{Bind Valve}" step="5" unit="%" show-value="true"/>
            </DvExpander>
            <DvExpander header="Notes (no binding — the screen remembers)">
              <DvLabel class="body" text="With no binding and no id, the screen remembers whether it is open."/>
            </DvExpander>
            <DvExpander header="Locked item (disabled)" disabled="true">
              <DvLabel class="body" text="Not shown"/>
            </DvExpander>
            <DvLabel class="caption muted" text="VM run conditions open = {ShowRun}"/>
          </DvStack>
          <DvStack gap="sm">
            <DvLabel class="label" text="Accordion (DvRepeat + item setter closes the others)"/>
            <DvRepeat items="{Sections}" gap="sm">
              <DvExpander header="{Item.Title}" expanded="{Bind Item.Open}">
                <DvLabel class="body" text="{Item.Body}"/>
              </DvExpander>
            </DvRepeat>
          </DvStack>
        </DvGrid>
      </DvTab>
      <DvTab value="motion" text="Motion">
        <DvGrid columns="2">
          <DvCard title="State transitions (transition)" badge="new">
            <DvStack gap="md">
              <DvLabel class="caption muted" text="Background fades on hover and press; shrinks slightly when pressed"/>
              <DvRow>
                <DvButton text="Smooth button" variant="primary" style="transition: background-color 180ms, transform 120ms ease-out" press-style="transform: scale(0.94)"/>
                <DvButton text="Secondary button" variant="secondary" style="transition: all 200ms" hover-style="background: token(tone-info-soft)"/>
              </DvRow>
              <DvLabel class="caption muted" text="opacity 0.3 s (fades when the bound value changes)"/>
              <DvRow>
                <DvButton text="Show / Hide" icon="fa-eye" variant="secondary" onclick="TogglePanel"/>
                <DvBox style="padding:10 16; border-radius:8; background: token(tone-success-soft); opacity:{PanelOpacity}; transition: opacity 300ms">
                  <DvLabel class="body" text="Ready to run"/>
                </DvBox>
              </DvRow>
              <DvLabel class="caption muted" text="transform move 0.4 s ease-in-out"/>
              <DvBox style="height:44; border-radius:8; background: token(surface-raised)">
                <DvBox style="width:44; height:44; border-radius:22; background: token(primary); transform: translateX({BallX}); transition: transform 400ms ease-in-out"/>
              </DvBox>
              <DvRow>
                <DvButton text="Left" icon="fa-arrow-left" variant="secondary" onclick="BallLeft"/>
                <DvButton text="Right" icon="fa-arrow-right" variant="secondary" onclick="BallRight"/>
              </DvRow>
            </DvStack>
          </DvCard>
          <DvCard title="Page transitions" badge="new">
            <DvStack gap="md">
              <DvLabel class="caption muted" text="App.Show(page, DvPageTransition.Fade / Slide)"/>
              <DvRow>
                <DvButton text="Next page with Fade" icon="fa-wand-magic-sparkles" variant="primary" onclick="GoFade"/>
                <DvButton text="Next page with Slide" icon="fa-right-long" variant="primary" onclick="GoSlide"/>
              </DvRow>
            </DvStack>
          </DvCard>
        </DvGrid>
      </DvTab>
      <DvTab value="display" text="Display">
        <DvStack gap="md">
          <DvCard title="Step bar (DvStepBar)" badge="new">
            <DvStack gap="md">
              <DvStepBar steps="{BatchSteps}" current="{BatchStep}" style="width:560"/>
              <DvRow>
                <DvButton text="Prev step" icon="fa-backward-step" variant="secondary" onclick="PrevStep"/>
                <DvButton text="Next step" icon="fa-forward-step" variant="primary" onclick="NextStep"/>
                <DvLabel class="caption muted" text="current = {BatchStep} (0 = not started, 6 = all done)"/>
              </DvRow>
              <DvStepBar steps="Wash, Rinse, Dry" current="2"/>
            </DvStack>
          </DvCard>
          <DvCard title="Charts (sparkline · bar · pie)" badge="new">
            <DvStack gap="md">
              <DvRow gap="lg">
                <DvStack gap="xs">
                  <DvLabel class="caption muted" text="Flow (last 20)"/>
                  <DvRow gap="sm">
                    <DvSparkline values="{Flow}" area="true"/>
                    <DvLabel class="title" text="{FlowNow} m³/h"/>
                  </DvRow>
                </DvStack>
                <DvStack gap="xs">
                  <DvLabel class="caption muted" text="Pressure"/>
                  <DvSparkline values="{Pressure}" tone="warning" style="width:160"/>
                </DvStack>
                <DvSpacer/>
                <DvButton text="Shuffle data" icon="fa-shuffle" variant="secondary" onclick="Shuffle"/>
              </DvRow>
              <DvRow gap="lg">
                <DvBarChart items="{Lines}" item-value="Count" item-text="Name" show-value="true" style="width:320; height:180"/>
                <DvPieChart items="{Lines}" item-value="Count" item-text="Name" inner-radius="0.55" show-value="true" style="width:300; height:180"/>
              </DvRow>
            </DvStack>
          </DvCard>
        </DvStack>
      </DvTab>
    </DvTabs>
    <DvCard title="From code" badge="handle" style="width:380">
      <DvStack gap="sm">
        <DvRow>
          <DvButton id="btnCode" text="Turn on by code" icon="fa-code" variant="primary" onclick="CodeOn"/>
          <DvButton id="btnReset" text="Reset" icon="fa-rotate-left" variant="secondary" onclick="Reset"/>
        </DvRow>
        <DvRow>
          <DvLabel class="label" text="Binding + handle (auto run)"/>
          <DvSpacer/>
          <DvToggle id="tgAuto" value="{Bind Auto}" style="width:46; height:26"/>
        </DvRow>
        <DvLabel class="caption muted" text="VM Auto = {Auto}"/>
        <DvLabel class="label" text="Current values (read from handles)"/>
        <DvLabel id="lblNow" class="body" text=" "/>
        <DvLabel class="label" text="Change events (last 8)"/>
        <DvLabel id="lblLog" class="caption" text=" "/>
      </DvStack>
    </DvCard>
  </DvRow>
</DvPageFrame>

<DvPageFrame vm="HomePage" title="Home" subtitle="Page navigation demo — move with the buttons or the top bar, and return with 'Back' on each page">
  <DvRow gap="lg" align="stretch">
    <DvCard title="Monitoring" grow="1">
      <DvStack gap="md">
        <DvLabel class="body muted" text="Operations dashboard"/>
        <DvButton variant="primary" text="Go to Monitoring" onclick="ShowMonitor"/>
      </DvStack>
    </DvCard>
    <DvCard title="Settings" grow="1">
      <DvStack gap="md">
        <DvLabel class="body muted" text="Adjust setpoints"/>
        <DvButton variant="primary" text="Go to Settings" onclick="ShowSetting"/>
      </DvStack>
    </DvCard>
    <DvCard title="Alarms" grow="1">
      <DvStack gap="md">
        <DvLabel class="body muted" text="Check alarms"/>
        <DvButton variant="primary" text="Go to Alarms" onclick="ShowAlarm"/>
      </DvStack>
    </DvCard>
  </DvRow>
</DvPageFrame>

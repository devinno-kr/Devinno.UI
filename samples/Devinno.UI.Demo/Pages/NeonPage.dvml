<DvScreen vm="NeonPage" style="background:linear-gradient(160deg, #161c30, #0e1222); padding:28; display:flex; flex-direction:column; gap:22; align-items:stretch">
  <DvBox style="display:flex; flex-direction:row; align-items:center; gap:16">
    <DvBox style="width:10; height:34; border-radius:5; background:linear-gradient(180deg, #22d3ee, #2563eb); box-shadow:0 0 14 #22d3ee99"/>
    <DvBox style="display:flex; flex-direction:column; gap:2">
      <DvLabel text="NEXUS CONTROL" style="color:#f1f5f9; font-size:22; font-weight:bold"/>
      <DvLabel text="Smart equipment monitoring" style="color:#64748b; font-size:12"/>
    </DvBox>
    <DvBox style="flex-grow:1"/>
    <DvBox style="width:300; height:44; border-radius:22; background:#222a42; display:flex; flex-direction:row; align-items:center; gap:14; padding:0 6 0 6">
      <DvBox style="width:32; height:32; border-radius:16; background:linear-gradient(135deg, #22d3ee, #2563eb); box-shadow:0 0 12 #22d3ee77; display:flex; justify-content:center; align-items:center">
        <DvLabel text="Q" style="color:#ffffff; font-size:14; font-weight:bold"/>
      </DvBox>
      <DvLabel text="SEARCH" style="color:#7c88a8; font-size:13; font-weight:bold"/>
    </DvBox>
    <DvToggle value="{Bind Data.Online}" style="width:58; height:32"/>
  </DvBox>
  <DvBox style="display:flex; flex-direction:row; align-items:center; gap:18">
    <DvBox onclick="Toggle" style="width:200; height:48; border-radius:24; background:linear-gradient(90deg, #06b6d4, #3b82f6); box-shadow:0 0 22 #22d3ee77; display:flex; justify-content:center; align-items:center" hover-style="background:linear-gradient(90deg, #22d3ee, #60a5fa)" press-style="background:linear-gradient(90deg, #0891b2, #2563eb)">
      <DvLabel text="START" style="color:#ffffff; font-size:16; font-weight:bold"/>
    </DvBox>
    <DvBox style="width:200; height:48; border-radius:24; background:#121829; border:2 #22d3ee; box-shadow:0 0 14 #22d3ee44; display:flex; justify-content:center; align-items:center" hover-style="background:#22d3ee1a">
      <DvLabel text="SETTINGS" style="color:#a5f3fc; font-size:16; font-weight:bold"/>
    </DvBox>
    <DvBox style="flex-grow:1"/>
    <DvBox style="width:46; height:46; border-radius:23; background:#121829; border:2 #22d3ee; display:flex; justify-content:center; align-items:center" hover-style="box-shadow:0 0 24 #22d3eeaa">
      <DvLabel text="II" style="color:#a5f3fc; font-size:17; font-weight:bold"/>
    </DvBox>
    <DvBox style="width:46; height:46; border-radius:23; background:linear-gradient(135deg, #22d3ee, #2563eb); box-shadow:0 0 16 #22d3ee77; display:flex; justify-content:center; align-items:center" hover-style="box-shadow:0 0 24 #22d3eeaa">
      <DvLabel text="&gt;" style="color:#ffffff; font-size:17; font-weight:bold"/>
    </DvBox>
    <DvBox style="width:14"/>
    <DvBox style="width:46; height:46; border-radius:23; background:linear-gradient(135deg, #22d3ee, #2563eb); box-shadow:0 0 16 #22d3ee77; display:flex; justify-content:center; align-items:center" hover-style="box-shadow:0 0 24 #22d3eeaa">
      <DvLabel text="&lt;" style="color:#ffffff; font-size:17; font-weight:bold"/>
    </DvBox>
    <DvBox style="width:46; height:46; border-radius:23; background:#121829; border:2 #22d3ee; display:flex; justify-content:center; align-items:center" hover-style="box-shadow:0 0 24 #22d3eeaa">
      <DvLabel text="&gt;" style="color:#a5f3fc; font-size:17; font-weight:bold"/>
    </DvBox>
    <DvBox style="width:14"/>
    <DvBox style="width:46; height:46; border-radius:10; background:#2b3350; box-shadow:0 6 14 #00000055; display:flex; justify-content:center; align-items:center" hover-style="background:#353e60">
      <DvLabel text="=" style="color:#e2e8f0; font-size:18; font-weight:bold"/>
    </DvBox>
    <DvBox style="width:46; height:46; border-radius:10; background:#2b3350; box-shadow:0 6 14 #00000055; display:flex; justify-content:center; align-items:center" hover-style="background:#353e60">
      <DvLabel text="X" style="color:#e2e8f0; font-size:18; font-weight:bold"/>
    </DvBox>
  </DvBox>
  <DvBox style="flex-grow:1; display:flex; flex-direction:row; gap:22; align-items:stretch">
    <DvBox style="width:360; display:flex; flex-direction:column; gap:22; align-items:stretch">
      <DvBox style="display:flex; flex-direction:row; gap:22; align-items:stretch">
        <DvBox style="width:0; flex-grow:1; background:#1b2238; border-radius:18; border:1 #2a3352; box-shadow:0 12 30 #00000055; padding:20; display:flex; flex-direction:column; align-items:stretch; gap:8">
          <DvLabel text="LINE 1" style="color:#7c88a8; font-size:11; font-weight:bold"/>
          <DvLabel text="75%" style="color:#ffffff; font-size:34; font-weight:bold"/>
          <DvLabel text="vs target" style="color:#64748b; font-size:11"/>
          <DvBox style="height:6; border-radius:3; background:#262e48; position:relative">
            <DvBox style="position:absolute; left:0; top:0; width:88; height:6; border-radius:3; background:linear-gradient(90deg, #2563eb, #22d3ee); box-shadow:0 0 8 #22d3ee88"/>
          </DvBox>
        </DvBox>
        <DvBox style="width:0; flex-grow:1; background:#1b2238; border-radius:18; border:1 #2a3352; box-shadow:0 12 30 #00000055; padding:20; display:flex; flex-direction:column; align-items:stretch; gap:8">
          <DvLabel text="LINE 2" style="color:#7c88a8; font-size:11; font-weight:bold"/>
          <DvLabel text="50%" style="color:#ffffff; font-size:34; font-weight:bold"/>
          <DvLabel text="vs target" style="color:#64748b; font-size:11"/>
          <DvBox style="height:6; border-radius:3; background:#262e48; position:relative">
            <DvBox style="position:absolute; left:0; top:0; width:59; height:6; border-radius:3; background:linear-gradient(90deg, #2563eb, #22d3ee); box-shadow:0 0 8 #22d3ee88"/>
          </DvBox>
        </DvBox>
      </DvBox>
      <DvBox style="flex-grow:1; background:#1b2238; border-radius:18; border:1 #2a3352; box-shadow:0 12 30 #00000055; padding:20; display:flex; flex-direction:column; align-items:stretch; gap:16">
        <DvBox style="display:flex; flex-direction:row; align-items:center">
          <DvLabel text="Production progress" style="color:#e2e8f0; font-size:14; font-weight:bold"/>
          <DvBox style="flex-grow:1"/>
          <DvLabel text="3 / 5" style="color:#a5f3fc; font-size:14; font-weight:bold"/>
        </DvBox>
        <DvBox style="display:flex; flex-direction:column; gap:8">
          <DvBox style="width:318; display:flex; flex-direction:row">
            <DvLabel text="Material feed" style="color:#94a3b8; font-size:12"/>
            <DvBox style="flex-grow:1"/>
            <DvLabel text="42%" style="color:#a5f3fc; font-size:12; font-weight:bold"/>
          </DvBox>
          <DvBox style="width:318; height:22; position:relative">
            <DvBox style="position:absolute; left:0; top:4; width:318; height:14; border-radius:7; background:#262e48"/>
            <DvBox style="position:absolute; left:0; top:4; width:133; height:14; border-radius:7; background:linear-gradient(90deg, #2563eb, #22d3ee); box-shadow:0 0 12 #22d3ee66"/>
            <DvBox style="position:absolute; left:122; top:0; width:22; height:22; border-radius:11; background:#1e3a8a; border:3 #22d3ee; box-shadow:0 0 12 #22d3eeaa"/>
          </DvBox>
        </DvBox>
        <DvBox style="display:flex; flex-direction:column; gap:8">
          <DvBox style="width:318; display:flex; flex-direction:row">
            <DvLabel text="Mixing" style="color:#94a3b8; font-size:12"/>
            <DvBox style="flex-grow:1"/>
            <DvLabel text="68%" style="color:#a5f3fc; font-size:12; font-weight:bold"/>
          </DvBox>
          <DvBox style="width:318; height:22; position:relative">
            <DvBox style="position:absolute; left:0; top:4; width:318; height:14; border-radius:7; background:#262e48"/>
            <DvBox style="position:absolute; left:0; top:4; width:216; height:14; border-radius:7; background:linear-gradient(90deg, #1d4ed8, #0ea5e9, #1d4ed8, #0ea5e9, #1d4ed8, #22d3ee); box-shadow:0 0 12 #22d3ee66"/>
            <DvBox style="position:absolute; left:205; top:0; width:22; height:22; border-radius:11; background:#1e3a8a; border:3 #22d3ee; box-shadow:0 0 12 #22d3eeaa"/>
          </DvBox>
        </DvBox>
        <DvBox style="display:flex; flex-direction:column; gap:8">
          <DvBox style="width:318; display:flex; flex-direction:row">
            <DvLabel text="Forming" style="color:#94a3b8; font-size:12"/>
            <DvBox style="flex-grow:1"/>
            <DvLabel text="86%" style="color:#a5f3fc; font-size:12; font-weight:bold"/>
          </DvBox>
          <DvBox style="width:318; height:22; position:relative">
            <DvBox style="position:absolute; left:0; top:4; width:318; height:14; border-radius:7; background:#262e48"/>
            <DvBox style="position:absolute; left:0; top:4; width:273; height:14; border-radius:7; background:linear-gradient(90deg, #2563eb, #22d3ee); box-shadow:0 0 12 #22d3ee66"/>
            <DvBox style="position:absolute; left:262; top:0; width:22; height:22; border-radius:11; background:#1e3a8a; border:3 #22d3ee; box-shadow:0 0 12 #22d3eeaa"/>
          </DvBox>
        </DvBox>
        <DvBox style="display:flex; flex-direction:column; gap:8">
          <DvBox style="width:318; display:flex; flex-direction:row">
            <DvLabel text="Drying" style="color:#94a3b8; font-size:12"/>
            <DvBox style="flex-grow:1"/>
            <DvLabel text="57%" style="color:#a5f3fc; font-size:12; font-weight:bold"/>
          </DvBox>
          <DvBox style="width:318; height:22; position:relative">
            <DvBox style="position:absolute; left:0; top:4; width:318; height:14; border-radius:7; background:#262e48"/>
            <DvBox style="position:absolute; left:0; top:4; width:181; height:14; border-radius:7; background:linear-gradient(90deg, #2563eb, #22d3ee); box-shadow:0 0 12 #22d3ee66"/>
            <DvBox style="position:absolute; left:170; top:0; width:22; height:22; border-radius:11; background:#1e3a8a; border:3 #22d3ee; box-shadow:0 0 12 #22d3eeaa"/>
          </DvBox>
        </DvBox>
        <DvBox style="display:flex; flex-direction:column; gap:8">
          <DvBox style="width:318; display:flex; flex-direction:row">
            <DvLabel text="Packing" style="color:#94a3b8; font-size:12"/>
            <DvBox style="flex-grow:1"/>
            <DvLabel text="24%" style="color:#a5f3fc; font-size:12; font-weight:bold"/>
          </DvBox>
          <DvBox style="width:318; height:22; position:relative">
            <DvBox style="position:absolute; left:0; top:4; width:318; height:14; border-radius:7; background:#262e48"/>
            <DvBox style="position:absolute; left:0; top:4; width:76; height:14; border-radius:7; background:linear-gradient(90deg, #2563eb, #22d3ee); box-shadow:0 0 12 #22d3ee66"/>
            <DvBox style="position:absolute; left:65; top:0; width:22; height:22; border-radius:11; background:#1e3a8a; border:3 #22d3ee; box-shadow:0 0 12 #22d3eeaa"/>
          </DvBox>
        </DvBox>
      </DvBox>
    </DvBox>
    <DvBox style="width:0; flex-grow:1; background:#1b2238; border-radius:18; border:1 #2a3352; box-shadow:0 12 30 #00000055; padding:20; display:flex; flex-direction:column; align-items:stretch; gap:14">
      <DvBox style="display:flex; flex-direction:row; align-items:center; gap:10">
        <DvLabel text="Hourly load" style="color:#e2e8f0; font-size:14; font-weight:bold"/>
        <DvBox style="flex-grow:1"/>
        <DvBox style="display:flex; flex-direction:row; align-items:center; gap:6">
          <DvBox style="width:8; height:8; border-radius:4; background:#22d3ee"/>
          <DvLabel text="6,532" style="color:#94a3b8; font-size:12"/>
        </DvBox>
        <DvBox style="display:flex; flex-direction:row; align-items:center; gap:6">
          <DvBox style="width:8; height:8; border-radius:4; background:#3b82f6"/>
          <DvLabel text="3,523" style="color:#94a3b8; font-size:12"/>
        </DvBox>
      </DvBox>
      <DvBox style="flex-grow:1; display:flex; flex-direction:row; justify-content:space-between; align-items:end; padding:0 4">
        <DvBox style="display:flex; flex-direction:column; gap:4; align-items:center">
